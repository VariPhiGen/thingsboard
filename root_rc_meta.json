      "type": "org.thingsboard.rule.engine.action.TbCreateAlarmNode",
      "name": "AI Predictive Alert",
      "debugSettings": null,
      "singletonMode": false,
      "queueName": null,
      "configurationVersion": 0,
      "configuration": {
        "scriptLang": "JS",
        "alarmDetailsBuildJs": "\nreturn {\n  description: 'AI predictive CRITICAL risk detected on DG SET1. Review summary and take recommended action.',\n  summary: msg.summary,\n  severity: msg.severity,\n  health_score: msg.health_score,\n  failure_risk_pct: msg.failure_risk_pct,\n  recommendation: msg.maintenance_recommendation,\n  ai_mode: msg.ai_mode,\n  message: (msg.summary != null ? (''+msg.summary) : 'AI CRITICAL alert') +\n           (msg.maintenance_recommendation != null ? (' | Action: ' + msg.maintenance_recommendation) : '')\n};\n",
        "alarmDetailsBuildTbel": "return {};",
        "alarmType": "AI Predictive Alert",
        "severity": "CRITICAL",
        "propagate": false,
        "propagateToOwner": false,
        "propagateToTenant": false,
        "useMessageAlarmData": false,
        "overwriteAlarmDetails": true,
        "dynamicSeverity": false,
        "relationTypes": []
      },
