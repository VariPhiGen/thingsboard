      },
      "type": "org.thingsboard.rule.engine.ai.TbAiNode",
      "name": "DG SET1 AI Predictive",
      "debugSettings": null,
      "singletonMode": false,
      "queueName": null,
      "configurationVersion": 0,
      "configuration": {
        "modelId": {
          "entityType": "AI_MODEL",
          "id": "d78b28f0-810f-11f1-a760-b3ba4cbe1b98"
        },
        "systemPrompt": "You are a production diesel-generator (Woodward KG1500) monitoring assistant for industrial operators.\nUse ONLY the metrics provided. Never invent sensor values.\nRespond with one JSON object only (no markdown) with keys:\nanomaly (boolean),\nsummary (REQUIRED: 1-2 operator sentences. Include the most important live readings when present \u2014 e.g. RPM, coolant \u00b0C, oil pressure kPa, power kW, battery V. State whether running normal / idle / elevated risk and why. Do NOT only say 'all parameters normal' \u2014 always cite numbers.),\nseverity (OK|WARNING|CRITICAL),\nhealth_score (0-100),\nfailure_risk_pct (0-100),\nrul_hours (>=0),\npredicted_coolant_1h (number \u00b0C \u2014 REQUIRED whenever coolant_temp is present; else omit),\nmaintenance_recommendation (one short concrete action).\nNormal guides when present: RPM~1500, coolant<95C, oil_pressure>250 kPa, battery 24-28V, frequency~50Hz, PF>0.8.\nBe conservative: CRITICAL only for clear equipment risk from valid readings.\nKeep summary under 220 characters.",
        "userPrompt": "DG SET1 cleaned telemetry JSON: $[*]. valid_metric_count=${valid_metric_count}. Produce predictive JSON now.",
        "responseFormat": {
          "type": "JSON"
        },
        "timeoutSeconds": 90,
        "forceAck": true
      },
      "externalId": null,
      "additionalInfo": {
        "layoutX": 760,
        "layoutY": 560
      }
    },
    {
      "id": {
        "entityType": "RULE_NODE",
        "id": "0c41a782-8206-11f1-a760-b3ba4cbe1b98"
      },
      "createdTime": 1784309791224,
      "ruleChainId": {
        "entityType": "RULE_CHAIN",
        "id": "1d524b90-6a70-11f1-87c3-df6f31aa9de9"
      },
      "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
      "name": "Clamp AI Outputs",
      "debugSettings": null,
      "singletonMode": false,
      "queueName": null,
      "configurationVersion": 0,
      "configuration": {
        "scriptLang": "JS",
        "jsScript": "\nvar out = {};\nfunction num(v, d) {\n  if (v === null || v === undefined || v === '') return d;\n  if (typeof v === 'string' && (v === '--' || v === 'N/A' || v === 'Unavailable' || v.indexOf('Waiting') === 0)) return d;\n  var n = Number(v);\n  if (!isFinite(n) || n === 32767 || n >= 30000) return d;\n  return n;\n}\nfunction clamp(n, lo, hi) {\n  if (n === null || n === undefined) return null;\n  return Math.max(lo, Math.min(hi, n));\n}\nout.anomaly = (msg.anomaly === true || msg.anomaly === 'true');\nout.summary = (msg.summary != null && (''+msg.summary).trim() !== '') ? (''+msg.summary).substring(0, 240) : 'No AI summary';\nvar sev = (msg.severity != null) ? (''+msg.severity).toUpperCase() : 'OK';\nif (sev === 'SENSOR FAULT' || sev === 'SENSOR_FAULT') sev = 'WARNING';\nif (['OK','WARNING','CRITICAL'].indexOf(sev) < 0) sev = 'OK';\nout.severity = sev;\nout.health_score = clamp(num(msg.health_score, 50), 0, 100);\nout.failure_risk_pct = clamp(num(msg.failure_risk_pct, 0), 0, 100);\nout.rul_hours = Math.max(0, num(msg.rul_hours, 0));\n// Always overwrite predicted_coolant_1h on ACTIVE path (avoid stale '--' from pause)\nvar pc = num(msg.predicted_coolant_1h, null);\nif (pc === null && metadata) pc = num(metadata.coolant_temp, null);\nif (pc === null) pc = num(msg.coolant_temp, null);\nif (pc !== null) out.predicted_coolant_1h = clamp(pc, -20, 150);\nelse out.predicted_coolant_1h = '--';\nout.maintenance_recommendation = (msg.maintenance_recommendation != null)\n  ? (''+msg.maintenance_recommendation).substring(0, 300)\n  : 'Continue monitoring';\nout.ai_mode = 'openai';\nout.ai_status = 'ACTIVE';\nout.ai_reason = 'Predictive analysis running';\nreturn {msg: out, metadata: metadata, msgType: 'POST_TELEMETRY_REQUEST'};\n",
        "tbelScript": "return {msg: msg, metadata: metadata, msgType: msgType};"
      },
      "externalId": null,
      "additionalInfo": {
        "layoutX": 1000,
        "layoutY": 560
      }
    },
