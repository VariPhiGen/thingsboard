      },
      "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
      "name": "Compute DG Status",
      "debugSettings": {
        "failuresEnabled": false,
        "allEnabled": false,
        "allEnabledUntil": 0
      },
      "singletonMode": false,
      "queueName": null,
      "configurationVersion": 0,
      "configuration": {
        "scriptLang": "JS",
        "jsScript": "\nvar hasRpm = (typeof msg.engine_rpm !== 'undefined' && msg.engine_rpm !== null && msg.engine_rpm !== '');\nvar hasPwr = (typeof msg.power_kw !== 'undefined' && msg.power_kw !== null && msg.power_kw !== '');\nif (!hasRpm && !hasPwr) { return null; }\nvar rpm = Number(msg.engine_rpm);\nvar pwr = Number(msg.power_kw);\nvar running = (hasRpm && isFinite(rpm) && rpm > 100) || (hasPwr && isFinite(pwr) && pwr > 5);\nreturn {msg: {dg_status: running ? 'RUNNING' : 'OFF'}, metadata: metadata, msgType: 'POST_TELEMETRY_REQUEST'};\n",
        "tbelScript": "return {msg: msg, metadata: metadata, msgType: msgType};"
      },
      "externalId": null,
      "additionalInfo": {
        "description": "RUNNING if RPM>100 or power>5 else OFF",
        "layoutX": 200,
        "layoutY": 580
      }
    },
