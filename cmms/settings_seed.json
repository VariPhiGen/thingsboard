               "Settings / software change", "Temporary fix", "No fault found"]
  },
  "doc_categories": ["Manual", "SOP / Procedure", "Checklist", "Drawing / Diagram", "Warranty / AMC", "Certificate",
                     "Statutory licence", "Service report", "Photo", "Other"],
