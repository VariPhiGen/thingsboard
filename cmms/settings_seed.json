  "wo_types": [
    {"name": "Preventive", "planned": true, "plan_allowed": true, "failure_codes": false, "pm_service_reset": true},
    {"name": "Inspection", "planned": true, "plan_allowed": true, "failure_codes": false, "pm_service_reset": false},
    {"name": "Statutory", "planned": true, "plan_allowed": true, "failure_codes": false, "pm_service_reset": false},
    {"name": "Calibration", "planned": true, "plan_allowed": true, "failure_codes": false, "pm_service_reset": false},
    {"name": "Corrective", "planned": false, "plan_allowed": false, "failure_codes": true, "pm_service_reset": false},
    {"name": "Condition-based", "planned": false, "plan_allowed": false, "failure_codes": true, "pm_service_reset": false}
