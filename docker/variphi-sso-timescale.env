# External shared infrastructure for the Variphi IoT (ThingsBoard) SSO stack.
# This file is consumed by docker-compose.variphi-sso.yml for ${VAR} substitution.
#
# Load it explicitly:
#   docker compose --env-file variphi-sso.env -f docker-compose.variphi-sso.yml --profile install up tb-install
#   docker compose --env-file variphi-sso.env -f docker-compose.variphi-sso.yml up -d mytb
#
# NOTE: contains secrets — add `docker/variphi-sso.env` to .gitignore; do not commit real credentials.

# --- PostgreSQL (shared, external) ---
DATABASE_HOST=13.206.196.162
DATABASE_PORT=5432
DATABASE_NAME=tb_timescale
DATABASE_USER=variphi
DATABASE_PASSWORD=vgi@2026

# --- TimescaleDB telemetry (set after cutover to tb_timescale) ---
DATABASE_TS_TYPE=timescale
DATABASE_TS_LATEST_TYPE=timescale
SQL_TIMESCALE_CHUNK_TIME_INTERVAL=604800000
SQL_TIMESCALE_BATCH_THREADS=3

# --- Redis cache (shared, external) ---
CACHE_TYPE=redis
REDIS_CONNECTION_TYPE=standalone
REDIS_HOST=13.206.196.162
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=variphi@2024

# --- Variphi IoT image (build from this fork, then tag it to match) ---
TB_IMAGE=variphi/tb-node:latest

# --- Keycloak SSO (api.edge.variphi.com — Variphi-only realm viot) ---
TB_OAUTH2_CLIENT_SECRET=07efad71-2d29-4df2-bfe7-6fa998ddff68
SECURITY_OAUTH2_KEYCLOAK_CLIENT_ID=viot
SECURITY_OAUTH2_KEYCLOAK_ISSUER_URI=https://api.edge.variphi.com/auth/realms/viot
SECURITY_OAUTH2_KEYCLOAK_AUTH_ISSUER_URI=https://api.edge.variphi.com/auth/realms/viot
SECURITY_OAUTH2_KEYCLOAK_DOMAIN_NAME=viot.variphi.com

# --- "Connect device" instructions: public endpoints ---
DEVICE_CONNECTIVITY_HTTP_HOST=viot.variphi.com
DEVICE_CONNECTIVITY_HTTP_PORT=443
DEVICE_CONNECTIVITY_MQTT_HOST=viot.variphi.com
DEVICE_CONNECTIVITY_MQTT_PORT=8883

# --- First-run install ---
LOAD_DEMO=false
