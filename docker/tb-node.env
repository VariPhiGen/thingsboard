# ThingsBoard server configuration

ZOOKEEPER_ENABLED=true
ZOOKEEPER_URL=zookeeper:2181
JS_EVALUATOR=remote
TRANSPORT_TYPE=remote

HTTP_LOG_CONTROLLER_ERROR_STACK_TRACE=false

METRICS_ENABLED=true
METRICS_ENDPOINTS_EXPOSE=prometheus

# Variphi Keycloak SSO (seeded into DB on install when enabled).
# Set SECURITY_OAUTH2_KEYCLOAK_ENABLED=true and point at your existing Keycloak client.
SECURITY_OAUTH2_KEYCLOAK_ENABLED=true
SECURITY_OAUTH2_KEYCLOAK_TITLE=Variphi SSO
SECURITY_OAUTH2_KEYCLOAK_CLIENT_ID=thingsboard
SECURITY_OAUTH2_KEYCLOAK_CLIENT_SECRET=thingsboard-oauth2-secret
# Backend-facing issuer (TB container -> existing vgi-microservices Keycloak via the host's published :8081).
# Requires `extra_hosts: ["host.docker.internal:host-gateway"]` on the TB service (Linux).
SECURITY_OAUTH2_KEYCLOAK_ISSUER_URI=http://host.docker.internal:8081/realms/things
# Browser-facing issuer for the authorization redirect (host browser -> Keycloak published port).
# Leave blank in production when a single public issuer is reachable by both browser and backend.
SECURITY_OAUTH2_KEYCLOAK_AUTH_ISSUER_URI=http://localhost:8081/realms/things
SECURITY_OAUTH2_KEYCLOAK_DOMAIN_NAME=localhost:9090
SECURITY_OAUTH2_KEYCLOAK_SCOPES=openid,email,profile
