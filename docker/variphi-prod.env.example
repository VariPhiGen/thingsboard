# ─────────────────────────────────────────────────────────────────────────────
# Variphi IoT — PRODUCTION environment template.
# Copy to variphi-prod.env, fill in real values, keep it OUT of git.
# Used with:  docker compose --env-file variphi-prod.env -f docker-compose.variphi-sso.yml ...
#
# Assumes Variphi IoT runs behind a TLS reverse proxy (nginx/traefik/ALB) at https://<TB_DOMAIN>,
# and Keycloak is reachable at a single public issuer by BOTH the browser and the TB backend.
# ─────────────────────────────────────────────────────────────────────────────

# --- Variphi IoT image (build once, push to your registry, or build on the host) ---
TB_IMAGE=registry.example.com/variphi/tb-node:1.0.0

# --- PostgreSQL (production) ---
DATABASE_HOST=db.internal
DATABASE_PORT=5432
DATABASE_NAME=tb
DATABASE_USER=variphi
DATABASE_PASSWORD=CHANGE_ME_STRONG

# --- Redis cache (production; required for >1 node) ---
CACHE_TYPE=redis
REDIS_CONNECTION_TYPE=standalone
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_STRONG

# --- Keycloak SSO (single public issuer; no split-horizon in prod) ---
TB_OAUTH2_CLIENT_SECRET=CHANGE_ME_STRONG_CLIENT_SECRET
SECURITY_OAUTH2_KEYCLOAK_ISSUER_URI=https://auth.variphi.com/realms/things
# Leave AUTH_ISSUER_URI EMPTY in production (browser and backend share one issuer):
SECURITY_OAUTH2_KEYCLOAK_AUTH_ISSUER_URI=
# Public host TB is served on (host[:port]); for 443 use just the domain:
SECURITY_OAUTH2_KEYCLOAK_DOMAIN_NAME=iot.variphi.com

# --- "Connect device" instructions: show the PUBLIC endpoints ---
DEVICE_CONNECTIVITY_HTTP_HOST=iot.variphi.com
DEVICE_CONNECTIVITY_HTTP_PORT=443
DEVICE_CONNECTIVITY_MQTT_HOST=iot.variphi.com
DEVICE_CONNECTIVITY_MQTT_PORT=8883

# --- First-run only ---
LOAD_DEMO=false

# Reminders (configure in Keycloak + TB, not here):
#  • Keycloak "thingsboard" client redirect URI:  https://iot.variphi.com/login/oauth2/code/*
#    and post.logout.redirect.uris:               https://iot.variphi.com/*
#  • TB System Settings → General → Base URL:      https://iot.variphi.com
#  • Terminate TLS at the reverse proxy; forward to the mytb container's 8080 (and 1883 for MQTT).
