# --- Redis cache (shared server, separate DB index) ---
CACHE_TYPE=redis
REDIS_CONNECTION_TYPE=standalone
REDIS_HOST=13.206.196.162
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=variphi@2024

# --- Virtuoso NetSoft image ---
TB_IMAGE=virtuosonetsoft/tb-node:latest

# --- Keycloak SSO (dedicated auth.virtuosonetsoft.variphi.com — realm viot) ---
TB_OAUTH2_CLIENT_SECRET=cfab5cc2-8039-4547-a5cf-df757d01a247
SECURITY_OAUTH2_KEYCLOAK_CLIENT_ID=viot
SECURITY_OAUTH2_KEYCLOAK_ISSUER_URI=https://auth.virtuosonetsoft.variphi.com/realms/viot
