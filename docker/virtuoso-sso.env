DATABASE_PORT=5432
DATABASE_NAME=tb_virtuoso_timescale
DATABASE_USER=variphi
DATABASE_PASSWORD=vgi@2026

# --- TimescaleDB telemetry (set after cutover to tb_virtuoso_timescale) ---
