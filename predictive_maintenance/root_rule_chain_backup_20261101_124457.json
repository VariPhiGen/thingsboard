    },
    {
      "id": {
        "entityType": "RULE_NODE",
        "id": "fe5c8a40-8278-11f1-a760-b3ba4cbe1b98"
      },
      "createdTime": 1784359160036,
      "ruleChainId": {
        "entityType": "RULE_CHAIN",
        "id": "1d524b90-6a70-11f1-87c3-df6f31aa9de9"
      },
      "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
      "name": "Sanitize DG Sensors",
      "debugSettings": null,
      "singletonMode": false,
      "queueName": null,
      "configurationVersion": 0,
      "configuration": {
        "scriptLang": "JS",
        "jsScript": "\nfunction bad(k, v) {\n  if (v === null || typeof v === 'undefined' || v === '') return true;\n  var n = Number(v);\n  if (!isFinite(n)) return true;\n  if (n === 32767 || n >= 30000) return true;\n  if (k === 'engine_rpm' && (n < 0 || n > 2500)) return true;\n  if (k === 'coolant_temp' && (n < -20 || n > 150)) return true;\n  if (k === 'oil_pressure' && (n < 0 || n > 1000)) return true;\n  if ((k === 'frequency' || k === 'voltage' || k === 'voltage_delta') && n === 0) return true;\n  return false;\n}\nvar out = {};\nvar keys = ['power_kw','energy_kwh','engine_rpm','coolant_temp','oil_pressure','battery_voltage','voltage','voltage_delta','current','frequency','power_factor','run_hours','engine_starts','status'];\nvar count = 0;\nfor (var i=0;i<keys.length;i++) {\n  var k = keys[i];\n  if (typeof msg[k] === 'undefined') continue;\n  if (bad(k, msg[k])) continue;\n  out[k] = msg[k];\n  count++;\n}\nvar md = metadata || {};\nmd.valid_metric_count = '' + count;\nif (typeof out.coolant_temp !== 'undefined') md.coolant_temp = '' + out.coolant_temp;\nelse md.coolant_temp = '';\nreturn {msg: out, metadata: md, msgType: msgType};\n",
        "tbelScript": "return {msg: msg, metadata: metadata, msgType: msgType};"
      },
      "externalId": null,
      "additionalInfo": {
        "layoutX": 600,
        "layoutY": 560
      }
    },
    {
      "id": {
        "entityType": "RULE_NODE",
        "id": "fe5cb150-8278-11f1-a760-b3ba4cbe1b98"
      },
      "createdTime": 1784359160037,
      "ruleChainId": {
        "entityType": "RULE_CHAIN",
        "id": "1d524b90-6a70-11f1-87c3-df6f31aa9de9"
      },
      "type": "org.thingsboard.rule.engine.filter.TbJsFilterNode",
      "name": "Core Sensors Valid",
      "debugSettings": null,
      "singletonMode": false,
      "queueName": null,
      "configurationVersion": 0,
      "configuration": {
        "scriptLang": "JS",
        "jsScript": "\nfunction bad(k, v) {\n  if (v === null || typeof v === 'undefined' || v === '') return true;\n  var n = Number(v);\n  if (!isFinite(n)) return true;\n  if (n === 32767 || n >= 30000) return true;\n  if (k === 'engine_rpm' && (n < 0 || n > 2500)) return true;\n  if (k === 'coolant_temp' && (n < 20 || n > 130)) return true;\n  if (k === 'oil_pressure' && (n < 50 || n > 800)) return true;\n  return false;\n}\nvar core = 0;\nif (!bad('engine_rpm', msg.engine_rpm)) core++;\nif (!bad('coolant_temp', msg.coolant_temp)) core++;\nif (!bad('oil_pressure', msg.oil_pressure)) core++;\nreturn core >= 2;\n",
        "tbelScript": "return false;"
      },
      "externalId": null,
      "additionalInfo": {
        "layoutX": 720,
        "layoutY": 560
      }
    },
    {
      "id": {
        "entityType": "RULE_NODE",
        "id": "fe5cb151-8278-11f1-a760-b3ba4cbe1b98"
      },
      "createdTime": 1784359160037,
      "ruleChainId": {
        "entityType": "RULE_CHAIN",
        "id": "1d524b90-6a70-11f1-87c3-df6f31aa9de9"
      },
      "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
      "name": "Sensor Fault Fallback",
      "debugSettings": null,
      "singletonMode": false,
      "queueName": null,
      "configurationVersion": 0,
      "configuration": {
        "scriptLang": "JS",
        "jsScript": "\nvar out = {};\nout.anomaly = true;\nout.summary = 'Generator health scoring is paused because required engine sensors are missing or invalid. Live monitoring continues; predictive scores will return when sensor data is healthy.';\nout.severity = 'Sensors Unavailable';\nout.health_score = '--';\nout.failure_risk_pct = '--';\nout.rul_hours = '--';\nout.predicted_coolant_1h = '--';\nout.maintenance_recommendation = 'Please verify engine sensor connections (RPM, coolant temperature, and oil pressure) and confirm the gateway is sending valid readings. Predictive maintenance scoring will resume automatically once data is restored.';\nout.ai_mode = 'sensor_fault_fallback';\nout.ai_status = 'PAUSED';\nout.ai_reason = 'Required engine sensors unavailable';\nreturn {msg: out, metadata: metadata, msgType: 'POST_TELEMETRY_REQUEST'};\n",
        "tbelScript": "return {msg: msg, metadata: metadata, msgType: msgType};"
      },
      "externalId": null,
