      "configurationVersion": 0,
      "configuration": {
        "scriptLang": "JS",
        "jsScript": "// Pass only DG telemetry with a trustworthy RPM or power reading ('error', 32767/65535 and\n// out-of-range values are not readings). Other messages leave the DG status untouched.\nfunction valid(v, lo, hi) {\n  if (v === null || typeof v === 'undefined' || v === '') return null;\n  var n = Number(v);\n  if (!isFinite(n) || n === 32767 || n === 65535 || n < lo || n > hi) return null;\n  return n;\n}\nreturn valid(msg.engine_rpm, 0, 3000) !== null || valid(msg.power_kw, 0, 5000) !== null;\n",
        "tbelScript": "return true;"
      },
      "externalId": null,
      "additionalInfo": {
        "description": "Drops DG messages without a valid RPM/power reading",
